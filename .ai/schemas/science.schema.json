{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:schema:science:1",
  "title": "Jarvis scientific record envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(OBJ|RQ|HYP|ASM|DATA|VAR|METHOD|EXPERIMENT|ANALYSIS|RUN|RESULT|EVIDENCE|CLAIM|CONCLUSION|LIMIT|ARTIFACT|SOURCE|INSIGHT|CONFLICT)-[0-9]{3,}$"
        },
        "epistemic_basis": {
          "enum": ["observed", "computed", "inferred", "hypothesized"]
        },
        "evaluation_status": {
          "enum": ["supported", "refuted", "unresolved", "not_evaluated"]
        }
      },
      "additionalProperties": true
    }
  }
}
