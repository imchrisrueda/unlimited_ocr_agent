{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:schema:review:1",
  "title": "Jarvis review metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_id",
    "cycle",
    "executor",
    "reviewer",
    "result",
    "commit",
    "validation_commands",
    "summary",
    "findings",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^REVIEW-TASK-[0-9]{4}-[0-9]{3}$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "cycle": {"type": "integer", "minimum": 0},
    "executor": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "CHANGES_REQUIRED", "HUMAN_REVIEW_REQUIRED"]},
    "commit": {"type": ["string", "null"]},
    "validation_commands": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
