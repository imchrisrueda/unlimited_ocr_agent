{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:schema:task:1",
  "title": "Jarvis TASK metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "objective",
    "context",
    "dependencies",
    "scope",
    "out_of_scope",
    "requirements",
    "technical_constraints",
    "expected_files",
    "acceptance_criteria",
    "required_tests",
    "validation_commands",
    "documentation_impact",
    "executor",
    "reviewer",
    "relevant_references",
    "knowledge_impact",
    "scientific_impact",
    "do_not",
    "notes",
    "independent_review_required",
    "review_cycle",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "BACKLOG",
        "PLANNED",
        "BLOCKED",
        "READY",
        "EXECUTING",
        "TESTING",
        "REVIEW",
        "CHANGES_REQUIRED",
        "ACCEPTED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "objective": {"type": "string"},
    "context": {"type": "string"},
    "dependencies": {"$ref": "#/$defs/stringArray"},
    "scope": {"$ref": "#/$defs/stringArray"},
    "out_of_scope": {"$ref": "#/$defs/stringArray"},
    "requirements": {"$ref": "#/$defs/stringArray"},
    "technical_constraints": {"$ref": "#/$defs/stringArray"},
    "expected_files": {"$ref": "#/$defs/stringArray"},
    "acceptance_criteria": {"$ref": "#/$defs/stringArray"},
    "required_tests": {"$ref": "#/$defs/stringArray"},
    "validation_commands": {"$ref": "#/$defs/stringArray"},
    "documentation_impact": {"type": "string"},
    "executor": {"enum": ["gemini", "local", "codex", "human"]},
    "reviewer": {"enum": ["gemini", "local", "codex", "human"]},
    "relevant_references": {"$ref": "#/$defs/stringArray"},
    "knowledge_impact": {"type": "string"},
    "scientific_impact": {"type": "string"},
    "do_not": {"$ref": "#/$defs/stringArray"},
    "notes": {"type": "string"},
    "independent_review_required": {"type": "boolean"},
    "review_cycle": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
